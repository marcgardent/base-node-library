use maths (suite_r2)

geometry graph "grille hexagonale 2d"(
    colonnes: Int = 8 in 1..256,
    rangées: Int = 8 in 1..256,
    rayon: Float = 0.5 in 0.001..,
    marge: Float = 0.0 in 0.0..0.95
) -> (Maillage: Geometry, Centres: Geometry) {
  "Pavage hexagonal régulier en quinconce dans le plan XY, avec maillage et centres des cellules"
  nb = colonnes * rangées
  i = Index()
  col = mod(i, colonnes)
  row = floor(i / colonnes)
  dx = rayon * 1.732051
  dy = rayon * 1.5
  shift = mod(row, 2.0) * 0.5
  x = (col + shift - (colonnes - 0.5) * 0.5) * dx
  y = (row - (rangées - 1.0) * 0.5) * dy
  centres = Points(nb, CombineXYZ(x, y))
  r_eff = rayon * (1.0 - marge)
  c = MeshCircle(6, r_eff, fill_type: NGON)
  hex = Transform(c, rotation: (0.0, 0.0, 0.5235988))
  inst = InstanceOnPoints(centres, instance: hex)
  mesh = inst |> RealizeInstances()
    |> MergeByDistance(distance: rayon * 0.001)
  return (Maillage: mesh, Centres: centres)
}

geometry graph "grille triangulaire 2d"(
    colonnes: Int = 8 in 1..256,
    rangées: Int = 8 in 1..256,
    côté: Float = 0.5 in 0.001..
) -> Geometry {
  "Pavage régulier de triangles équilatéraux dans le plan XY"
  nx = colonnes + 1.0
  ny = rangées + 1.0
  grid = MeshGrid(vertices_x: nx, vertices_y: ny)
  i = Index()
  col = mod(i, nx)
  row = floor(i / nx)
  h = côté * 0.8660254
  shift = mod(row, 2.0) * 0.5
  x = (col + shift - colonnes * 0.5) * côté
  y = (row - rangées * 0.5) * h
  p = CombineXYZ(x, y)
  pos = SetPosition(grid.mesh, position: p)
  return Triangulate(pos)
}

geometry graph "spirale phyllotaxis 2d"(
    nombre: Int = 200 in 1..100000,
    rayon: Float = 1.0 in 0.001..
) -> (Points: Geometry, Facteur: Float) {
  "Distribution de tournesol en disque selon l'angle d'or et facteur radial"
  i = Index()
  f = sqrt(i / (nombre * 1.0))
  a = i * 2.399963
  r = f * rayon
  x = r * cos(a)
  y = r * sin(a)
  pts = Points(nombre, CombineXYZ(x, y))
  return (Points: pts, Facteur: f)
}

geometry graph "semis jitter 2d"(
    colonnes: Int = 10 in 1..256,
    rangées: Int = 10 in 1..256,
    taille: Vector = (2.0, 2.0, 0.0),
    désordre: Float = 0.8 in 0.0..1.0
) -> Geometry {
  "Grille 2D perturbée par tirage stratifié de la suite R2 pour une répartition sans amas"
  nb = colonnes * rangées
  dx = taille.x / colonnes
  dy = taille.y / rangées
  i = Index()
  col = mod(i, colonnes)
  row = floor(i / colonnes)
  base_x = (col + 0.5 - colonnes * 0.5) * dx
  base_y = (row + 0.5 - rangées * 0.5) * dy
  r2 = suite_r2(i)
  jit_x = (r2.x - 0.5) * dx * désordre
  jit_y = (r2.y - 0.5) * dy * désordre
  p = CombineXYZ(base_x + jit_x, base_y + jit_y)
  return Points(nb, p)
}

geometry graph "hachures 2d"(
    largeur: Float = 2.0 in 0.01..,
    hauteur: Float = 2.0 in 0.01..,
    lignes: Int = 24 in 2..1024,
    angle: Float = 0.785398,
    croisées: Bool = false
) -> Geometry {
  "Réseau régulier de lignes parallèles ou croisées orientées selon un angle"
  ligne = CurvePrimitiveLine(CombineXYZ(-largeur * 0.5), CombineXYZ(largeur * 0.5))
  step = hauteur / (lignes - 1.0)
  pts = Points(lignes, CombineXYZ(y: (Index() - (lignes - 1.0) * 0.5) * step))
  inst = InstanceOnPoints(pts, instance: ligne)
  l1 = inst |> RealizeInstances()
    |> Transform(rotation: CombineXYZ(z: angle))
  l2 = Transform(l1, rotation: (0.0, 0.0, 1.570796))
  toutes = l1 + l2
  return Switch(croisées, l1, toutes, input_type: GEOMETRY)
}
