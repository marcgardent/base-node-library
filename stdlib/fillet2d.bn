// Base Node Standard Library — Module fillet2d
// @module fillet2d
// @version 0.8.1
// @profile vector2d
// @edition 2026

use math (perpendicular)

// ---- 2D Fillets, Chamfers & Bevels ----

geometry graph "fillet corner"(
    p_prev: Vector,
    p: Vector,
    p_next: Vector,
    radius: Float = 0.2 in 0.0..
) -> (p1: Vector, p2: Vector, center: Vector) {
  "Analytically computes circular arc fillet tangent points (p1, p2) and circle center for a 2D corner"
  v1 = normalize(p_prev - p)
  v2 = normalize(p_next - p)
  cos_theta = Clamp(v1 ⋅ v2, -1.0, 1.0)
  angle = acos(cos_theta)
  half_angle = Clamp(angle * 0.5, 0.001, 1.570796)
  tan_half = tan(half_angle)
  sin_half = sin(half_angle)
  d = radius / tan_half
  h = radius / sin_half
  bisector = normalize(v1 + v2)
  p1 = p + v1 * d
  p2 = p + v2 * d
  c = p + bisector * h
  return (p1: p1, p2: p2, center: c)
}

geometry graph "fillet polygon"(
    polygon: Geometry,
    radius: Float = 0.2 in 0.0..,
    segments: Int = 4 in 1..64
) -> Geometry {
  "Rounds sharp corners of a 2D polygonal curve with constant or attribute-driven fillet radius"
  return FilletCurve(polygon, radius: radius, count: segments)
}

geometry graph "chamfer polygon"(polygon: Geometry, distance: Float = 0.1 in 0.0..) -> Geometry {
  "Cuts sharp corners of a 2D polygon with straight chamfers"
  return FilletCurve(polygon, radius: distance, count: 1)
}

geometry graph "fillet bezier handles"(
    curve: Geometry,
    radius: Float = 0.1 in 0.0..,
    threshold_angle: Float = 0.5 in 0.0..3.14159
) -> Geometry {
  "Smooths sharp kink angles along a 2D curve by introducing parametric rounding arcs"
  return FilletCurve(curve, radius: radius, count: 4)
}
