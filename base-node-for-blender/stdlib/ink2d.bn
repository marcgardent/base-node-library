// Base Node Standard Library — Module ink2d
// @module ink2d
// @version 0.8.2
// @profile ink2d
// @edition 2026

use math (bump, fbm)

geometry graph "living ink"(
    geometry: Geometry,
    amplitude: Float = 0.02 in 0.0..,
    frequency: Float = 3.0 in 0.0..,
    "radius variation": Float = 0.35 in 0.0..1.0,
    octaves: Int = 3 in 1..8
) -> Geometry {
  "Organic ink appearance displacing points and modulating radius with fractal noise"
  p = Position() * frequency
  offset = Normal().normal * (fbm(p, octaves) * amplitude)
  noise_r = fbm(p + (15.3, 27.1, 8.4), octaves)
  radius = max(Radius() * (1.0 + noise_r * radius_variation), 0.0)
  return geometry |> SetPosition(offset: offset)
    |> SetCurveRadius(radius: radius)
}

geometry graph "write on"(geometry: Geometry, progress: Float = 1.0 in 0.0..1.0) -> Geometry {
  "Animates the progressive reveal of strokes along spline parameter"
  return TrimCurve(geometry, end: Clamp(progress, min: 0.0, max: 1.0))
}

geometry graph "ink bleed"(
    geometry: Geometry,
    radius: Float = 0.02 in 0.0..,
    roughness: Float = 4.0 in 0.0..,
    octaves: Int = 3 in 1..8
) -> Geometry {
  "Simulates ink diffusion on absorbent paper with fractal displacement"
  p = Position() * roughness
  disp = Normal().normal * (fbm(p, octaves) * radius)
  return geometry |> SetPosition(offset: disp)
}

geometry graph "ink wobble"(
    geometry: Geometry,
    amplitude: Float = 0.03 in 0.0..,
    frequency: Float = 2.5 in 0.0..,
    seed: Float = 0.0
) -> Geometry {
  "Adds controlled organic hand-drawn wobble to stroke positions"
  p = Position() * frequency + CombineXYZ(seed * 17.3, seed * 31.7, seed * 7.1)
  w = Normal().normal * (fbm(p, 2) * amplitude)
  return geometry |> SetPosition(offset: w)
}

geometry graph "taper ends"(geometry: Geometry, smoothness: Float = 0.35 in 0.01..0.5) -> Geometry {
  "Tapers both stroke endpoints according to the smoothness parameter"
  u = SplineParameter()
  d = min(u.factor, 1.0 - u.factor)
  factor = MapRange(d, from_max: smoothness, interpolation_type: SMOOTHSTEP)
  return SetCurveRadius(geometry, radius: Radius() * factor)
}

geometry graph "double stroke"(
    geometry: Geometry,
    offset: Float = 0.03 in 0.0..,
    "radius factor": Float = 0.6 in 0.0..2.0,
    material: Material
) -> Geometry {
  "Adds a parallel secondary stroke offset along the normal with its own material"
  stroke2 = geometry |> SetPosition(offset: Normal().normal * offset)
    |> SetCurveRadius(radius: Radius() * radius_factor)
    |> SetMaterial(material: material)
  return geometry + stroke2
}

geometry graph "drop shadow 2d"(
    geometry: Geometry,
    offset: Vector = (0.08, 0.0, -0.08),
    material: Material
) -> Geometry {
  "Duplicates offset strokes with a shadow material, placed behind the original"
  shadow = geometry |> SetPosition(offset: offset)
    |> SetMaterial(material: material)
  return shadow + geometry
}
