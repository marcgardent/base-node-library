// @profile "vector2d"

geometry(is_modifier: false) graph "Relax Points"(
    Points: Geometry,
    Iterations: Int = 10 in 0..,
    Radius: Float = 0.1 in -10000.0..10000.0,
    Factor: Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> (Points: Geometry) {
  position = Position() @ hide
  capture_attribute_2 = CaptureAttribute(Points, Value: Radius)
  position_2 = Position() @ hide
  repeat_output = repeat(Iterations, Geometry: capture_attribute_2.geometry) {
    capture_attribute = CaptureAttribute(Geometry, Value: IndexOfNearest().index) @ hide
    vector_math = position_2 - FieldAtIndex(value: position, index: capture_attribute.value, data_type: FLOAT_VECTOR) @ hide
    vector_math_2 = normalize(vector_math) @ hide
    vector_math_4 = length(vector_math) @ hide
    math_3 = FieldAtIndex(value: capture_attribute_2.value, index: capture_attribute.value) + capture_attribute_2.value @ hide
    math_2 = vector_math_4 - math_3 @ hide
    math_4 = math_2 / -2.0 * Factor @ hide
    math = max(math_4, 0.0) @ hide
    vector_math_3 = vector_math_2 * math @ hide
    return SetPosition(capture_attribute.geometry, offset: vector_math_3)
  }
  return (Points: repeat_output)
}
