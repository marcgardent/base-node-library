// @profile "blender-geometry"

geometry graph ".deform curves"(
    Curves: Geometry,
    "Deform Surface": Geometry
) -> (Curves: Geometry) {
  "deformation" {
    position = Position() @ hide
    separate_components = SeparateComponents(Curves)
    attribute_domain_size = AttributeDomainSize(separate_components.curve, component: CURVE)
    boolean_math = not attribute_domain_size.point_count @ hide
    warning = Warning(boolean_math, "No Curves in Geometry")
  }
  "curve sample position" {
    position_2 = Position() @ hide
    field_at_index = FieldAtIndex(position_2, PointsOfCurve().point_index, data_type: FLOAT_VECTOR) @ hide
    field_on_domain = FieldOnDomain(field_at_index, domain: CURVE, data_type: FLOAT_VECTOR)
  }
  "rest" {
    sample_nearest_surface = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rp", data_type: FLOAT_VECTOR).attribute,
      sample_position: field_on_domain,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_2 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rn", data_type: FLOAT_VECTOR).attribute,
      sample_position: field_on_domain,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_3 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rt", data_type: FLOAT_VECTOR).attribute,
      sample_position: field_on_domain,
      data_type: FLOAT_VECTOR) @ hide
    axes_to_rotation = AxesToRotation(
      sample_nearest_surface_2.value,
      sample_nearest_surface_3.value) @ hide
    combine_transform = CombineTransform(sample_nearest_surface.value, axes_to_rotation) @ hide
  }
  "deform" {
    sample_nearest_surface_4 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dp", data_type: FLOAT_VECTOR).attribute,
      sample_position: field_on_domain,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_5 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dn", data_type: FLOAT_VECTOR).attribute,
      sample_position: field_on_domain,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_6 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dt", data_type: FLOAT_VECTOR).attribute,
      sample_position: field_on_domain,
      data_type: FLOAT_VECTOR) @ hide
    axes_to_rotation_2 = AxesToRotation(
      sample_nearest_surface_5.value,
      sample_nearest_surface_6.value) @ hide
    combine_transform_2 = CombineTransform(sample_nearest_surface_4.value, axes_to_rotation_2) @ hide
  }
  "deformation" .. {
    invert_matrix = InvertMatrix(combine_transform) @ hide
    matrix_multiply = MatrixMultiply(combine_transform_2, invert_matrix.matrix) @ hide
    transform_point = TransformPoint(
      position,
      FieldOnDomain(matrix_multiply, domain: CURVE, data_type: FLOAT4X4)) @ hide
    switch = Switch(
      attribute_domain_size.point_count,
      true_: SetPosition(separate_components.curve, position: transform_point),
      input_type: GEOMETRY) @ hide
  }
  return (Curves: switch)
}

geometry graph ".deform instances"(
    Instances: Geometry,
    "Deform Surface": Geometry
) -> (Instances: Geometry) {
  "deformation" {
    instance_transform = InstanceTransform() @ hide
    separate_components = SeparateComponents(Instances)
    attribute_domain_size = AttributeDomainSize(separate_components.instances, component: INSTANCES)
    boolean_math = not attribute_domain_size @ hide
  }
  "rest" {
    sample_nearest_surface = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rp", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_2 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rn", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_3 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rt", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    axes_to_rotation = AxesToRotation(
      sample_nearest_surface_2.value,
      sample_nearest_surface_3.value) @ hide
    combine_transform = CombineTransform(sample_nearest_surface.value, axes_to_rotation) @ hide
  }
  "deform" {
    sample_nearest_surface_4 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dp", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_5 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dn", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_6 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dt", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    axes_to_rotation_2 = AxesToRotation(
      sample_nearest_surface_5.value,
      sample_nearest_surface_6.value) @ hide
    combine_transform_2 = CombineTransform(sample_nearest_surface_4.value, axes_to_rotation_2) @ hide
  }
  "deformation" .. {
    invert_matrix = InvertMatrix(combine_transform) @ hide
    matrix_multiply_2 = MatrixMultiply(combine_transform_2, invert_matrix.matrix) @ hide
    matrix_multiply = MatrixMultiply(matrix_multiply_2, instance_transform) @ hide
    switch = Switch(
      attribute_domain_size,
      true_: SetInstanceTransform(separate_components.instances, transform: matrix_multiply),
      input_type: GEOMETRY) @ hide
  }
  warning = Warning(boolean_math, "No Instances in Geometry")
  return (Instances: switch)
}

geometry graph ".deform points"(Geometry: Geometry, "Deform Surface": Geometry) -> Geometry {
  "Surface Deformation" {
    position = Position() @ hide
    separate_components = SeparateComponents(Geometry)
  }
  "rest" {
    sample_nearest_surface = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rp", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_2 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rn", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_3 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("rt", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    axes_to_rotation = AxesToRotation(
      sample_nearest_surface_2.value,
      sample_nearest_surface_3.value) @ hide
    combine_transform = CombineTransform(sample_nearest_surface.value, axes_to_rotation) @ hide
  }
  "deform" {
    sample_nearest_surface_4 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dp", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_5 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dn", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    sample_nearest_surface_6 = SampleNearestSurface(
      deform_surface,
      NamedAttribute("dt", data_type: FLOAT_VECTOR).attribute,
      data_type: FLOAT_VECTOR) @ hide
    axes_to_rotation_2 = AxesToRotation(
      sample_nearest_surface_5.value,
      sample_nearest_surface_6.value) @ hide
    combine_transform_2 = CombineTransform(sample_nearest_surface_4.value, axes_to_rotation_2) @ hide
  }
  "Surface Deformation" .. {
    invert_matrix = InvertMatrix(combine_transform) @ hide
    matrix_multiply = MatrixMultiply(combine_transform_2, invert_matrix.matrix) @ hide
    transform_point = TransformPoint(position, matrix_multiply) @ hide
    set_position = SetPosition(
      separate_components.point_cloud + separate_components.grease_pencil + separate_components.curve + separate_components.mesh,
      position: transform_point)
  }
  return set_position
}

geometry graph "Surface Deform Basic"(
    Geometry: Geometry,
    Mode: Menu(description: "Which geometry the modifier will operate on", optional_label: true) = "Mesh/Points",
    "Surface Object": Object(optional_label: true),
    "Surface rest_position": String(optional_label: true) = "rest_position",
    UVMap: String(optional_label: true) = "UVMap",
    "Show Surface rest_position": Bool
) -> Geometry {
  "Deform geometry by mesh surface"
  "rest position" {
    named_attribute = NamedAttribute(surface_rest_position, data_type: FLOAT_VECTOR)
  }
  "deform object" {
    object_info = ObjectInfo(surface_object, transform_space: RELATIVE)
  }
  "deform loc,nrm,tan" {
    position = Position() @ hide
    normal = Normal(legacy_corner_normals: true) @ hide
  }
  "rest loc,nrm,tan" {
    position_2 = Position() @ hide
    normal_2 = Normal(legacy_corner_normals: true) @ hide
  }
  "smooth tangent" {
    uvtangent = UVTangent(uv: NamedAttribute(UVMap, data_type: FLOAT_VECTOR).attribute)
  }
  "deform loc,nrm,tan" .. {
    store_named_attribute = object_info.geometry |> StoreNamedAttribute(name: "dp", value: position, data_type: FLOAT_VECTOR)
      |> StoreNamedAttribute(name: "dn", value: normal.normal, data_type: FLOAT_VECTOR)
      |> StoreNamedAttribute(name: "dt", value: uvtangent, data_type: FLOAT_VECTOR, domain: CORNER)
  }
  "rest position" .. {
    set_position = SetPosition(store_named_attribute, position: named_attribute.attribute) @ hide
    vector_math = length(
      AttributeStatistic(store_named_attribute, attribute: named_attribute.attribute, data_type: FLOAT_VECTOR).range) @ hide
    compare = vector_math == 0.0 @ hide
    switch = Switch(compare, set_position, input_type: GEOMETRY) @ hide
  }
  "rest loc,nrm,tan" .. {
    store_named_attribute_2 = switch |> StoreNamedAttribute(name: "rp", value: position_2, data_type: FLOAT_VECTOR)
      |> StoreNamedAttribute(name: "rn", value: normal_2.normal, data_type: FLOAT_VECTOR)
      |> StoreNamedAttribute(name: "rt", value: uvtangent, data_type: FLOAT_VECTOR, domain: CORNER)
  }
  warning = Warning(compare, "Invalid rest_position on surface object")
  "debug" {
    geometry_to_instance = GeometryToInstance(switch) @ hide
    join_geometry = geometry_to_instance + Geometry
  }
  switch_2 = Switch(
    show_surface_rest_position,
    MenuSwitch(Mode, "Mesh/Points": deform_points(Geometry, store_named_attribute_2), Curves: deform_curves(Geometry, store_named_attribute_2), Instances: deform_instances(Geometry, store_named_attribute_2)).output,
    join_geometry,
    input_type: GEOMETRY) @ hide
  return switch_2
}
