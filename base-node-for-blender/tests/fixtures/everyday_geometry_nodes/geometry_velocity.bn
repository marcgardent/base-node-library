// Written by Base Node from tests/fixtures/everyday_geometry_nodes.blend;
// to write it again: BASE_NODE_UPDATE_FIXTURES=1, see tests/fixtures/README.md

// @profile "blender-geometry"

geometry graph "Geometry Velocity"(
    Geometry: Geometry(description: "Geometry whose instances are (partially) realized"),
    Menu: Menu(optional_label: true) = Points,
    ID: Int(description: "ID for Attribute Transfer", hide_value: true) = ID(),
    "Velocity Attribute": String(description: "Velocity Attribute", optional_label: true) = "velocity",
    "Global Space": Bool(description: "Apply Self Transform to Velocity"),
    "Old Instance Transform Attribute": String(optional_label: true) = "old_instance_transform",
    "Point Velocity (Non Deform)": Bool = true,
    "Point Velocity Attribute": String(optional_label: true) = "point_velocity"
) -> (Geometry: Geometry, "Delta Time": Float) {
  "Velocity of geometry"
  "points mode" {
    "instance warning " {
      realize_instances = RealizeInstances(Geometry) @ hide
      switch_2 = Switch(
        switch: Warning(show: AttributeDomainSize(Geometry, component: INSTANCES), message: "Instances Realized for Point Velocity", warning_type: INFO),
        false_: Geometry,
        true_: realize_instances,
        input_type: GEOMETRY) @ hide
    }
    "velocity" {
      position = Position() @ hide
      vector_math_2 = position - NamedAttribute(name: "reserved_old_position", data_type: FLOAT_VECTOR).attribute @ hide
    }
    "old point position from ID" {
      position_2 = Position() @ hide
      store_named_attribute = StoreNamedAttribute(
        switch_2,
        name: "reserved_old_position",
        value: position_2,
        data_type: FLOAT_VECTOR)
      simulation_output = simulate(
        Geometry: store_named_attribute,
        "Geometry.001": Geometry = _,
        "Delta Time" as delta_time_2: 0.0) {
        return (Geometry: store_named_attribute, "Geometry.001": Geometry, delta_time_2: delta_time)
      }
      transfer_attributes = TransferAttributes(
        store_named_attribute,
        target_point_id: ID,
        source: simulation_output.geometry_001,
        source_point_id: ID,
        attribute_names: FieldToList("Attribute Names": "reserved_old_position"))
    }
    "velocity" .. {
      vector_math = VectorMath(
        Vector: 1.0 / simulation_output.delta_time_2,
        Vector_001: vector_math_2,
        operation: MULTIPLY) @ hide
      "global space" {
        transform_direction = TransformDirection(
          direction: vector_math,
          transform: ObjectInfo(object: SelfObject()).transform) @ hide
        switch = Switch(
          switch: global_space,
          false_: vector_math,
          true_: transform_direction,
          input_type: VECTOR) @ hide
      }
      remove_attribute = transfer_attributes.target |> StoreNamedAttribute(name: velocity_attribute, value: switch, data_type: FLOAT_VECTOR)
        |> RemoveAttribute(name: "reserved_old_position")
    }
  }
  "menu" {
    menu_switch = MenuSwitch(menu: Menu, Points: 0, Instances: 1)
  }
  "instance mode" {
    "instance old transform" {
      index_2 = Index() @ hide
      "old instance transform (no points)" {
        instance_transform = InstanceTransform() @ hide
      }
      named_attribute = NamedAttribute(name: "reserved_instance_id", data_type: INT)
      separate_components = SeparateComponents(Geometry)
      "old instance transform (no points)" .. {
        instances_to_points = separate_components.instances |> StoreNamedAttribute(name: "reserved_instance_id", value: ID, data_type: INT, domain: INSTANCE)
          |> StoreNamedAttribute(name: "old_instance_transform", value: instance_transform, data_type: FLOAT4X4, domain: INSTANCE)
          |> InstancesToPoints()
        simulation_output_2 = simulate(
          Geometry: instances_to_points,
          "Geometry.001": Geometry = _,
          "Delta Time" as delta_time_2: 0.0) {
          return (Geometry: instances_to_points, "Geometry.001": Geometry, delta_time_2: delta_time)
        }
      }
      store_named_attribute_2 = StoreNamedAttribute(
        separate_components.instances,
        name: old_instance_transform_attribute,
        value: SampleIndex(TransferAttributes(instances_to_points, target_point_id: named_attribute.attribute, source: simulation_output_2.geometry_001, source_point_id: named_attribute.attribute, attribute_names: FieldToList("Attribute Names": "old_instance_transform")).target, value: NamedAttribute(name: "old_instance_transform", data_type: FLOAT4X4).attribute, index: index_2, data_type: FLOAT4X4),
        data_type: FLOAT4X4,
        domain: INSTANCE)
    }
    "instance velocity" {
      separate_transform = SeparateTransform(transform: InstanceTransform()) @ hide
      separate_transform_2 = SeparateTransform(
        transform: NamedAttribute(name: old_instance_transform_attribute, data_type: FLOAT4X4).attribute) @ hide
      vector_math_3 = separate_transform.translation - separate_transform_2.translation @ hide
      vector_math_4 = vector_math_3 * (1.0 / simulation_output_2.delta_time_2) @ hide
      "global space" {
        transform_direction_2 = TransformDirection(
          direction: vector_math_4,
          transform: ObjectInfo(object: SelfObject()).transform) @ hide
        switch_4 = Switch(
          switch: global_space,
          false_: vector_math_4,
          true_: transform_direction_2,
          input_type: VECTOR) @ hide
      }
      store_named_attribute_3 = StoreNamedAttribute(
        store_named_attribute_2,
        name: velocity_attribute,
        value: switch_4,
        data_type: FLOAT_VECTOR,
        domain: INSTANCE)
    }
    "store instance velocity on points (no deform velocity)" {
      position_3 = Position() @ hide
      foreach_output = foreach(
        store_named_attribute_3,
        domain: INSTANCE,
        Transform: InstanceTransform(),
        Attribute: NamedAttribute(name: old_instance_transform_attribute, data_type: FLOAT4X4).attribute) {
        transform_point = TransformPoint(vector: position_3, transform: Transform) @ hide
        transform_point_2 = TransformPoint(vector: position_3, transform: Attribute) @ hide
        vector_math_5 = transform_point - transform_point_2 @ hide
        vector_math_6 = vector_math_5 * (1.0 / simulation_output_2.delta_time_2) @ hide
        "global space" {
          transform_direction_3 = TransformDirection(
            direction: vector_math_6,
            transform: ObjectInfo(object: SelfObject()).transform) @ hide
          switch_5 = Switch(
            switch: global_space,
            false_: vector_math_6,
            true_: transform_direction_3,
            input_type: VECTOR) @ hide
        }
        return (
          Geometry: StoreNamedAttribute(element, name: point_velocity_attribute, value: switch_5, data_type: FLOAT_VECTOR))
      }
      switch_3 = Switch(
        switch: point_velocity_non_deform,
        false_: store_named_attribute_3,
        true_: foreach_output.Geometry,
        input_type: GEOMETRY) @ hide
    }
  }
  return (
    Geometry: IndexSwitch(menu_switch.output, remove_attribute, switch_3),
    "Delta Time": IndexSwitch(menu_switch.output, simulation_output.delta_time_2, simulation_output_2.delta_time_2))
}
