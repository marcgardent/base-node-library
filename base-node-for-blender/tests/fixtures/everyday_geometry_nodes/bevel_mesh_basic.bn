// @profile "blender-geometry"

geometry graph ".Closest Edge Edge Pair"(
    "Edge1 P1": Vector(hide_value: true) in -10000.0..10000.0,
    "Edge1 P2": Vector(hide_value: true) in -10000.0..10000.0,
    "Edge2 Q1": Vector(hide_value: true) in -10000.0..10000.0,
    "Edge2 Q2": Vector(hide_value: true) in -10000.0..10000.0
) -> ("Is Hit": Bool, P: Vector, Q: Vector) {
  vector_math = edge1_p2 - edge1_p1 @ "u" hide
  vector_math_2 = edge2_q2 - edge2_q1 @ "v" hide
  vector_math_3 = edge1_p1 - edge2_q1 @ "w" hide
  vector_math_4 = vector_math ⋅ vector_math @ "a" hide
  vector_math_5 = vector_math ⋅ vector_math_2 @ "b" hide
  vector_math_6 = vector_math_2 ⋅ vector_math_2 @ "c" hide
  vector_math_7 = vector_math ⋅ vector_math_3 @ "d" hide
  vector_math_8 = vector_math_2 ⋅ vector_math_3 @ "e" hide
  math = vector_math_4 * vector_math_6 @ hide
  math_3 = vector_math_5 * vector_math_5 @ hide
  math_2 = math - math_3 @ "delta" hide
  math_4 = vector_math_5 * vector_math_8 @ hide
  math_6 = vector_math_6 * vector_math_7 @ hide
  math_5 = math_4 - math_6 @ hide
  math_7 = Math(math_5, math_2, operation: DIVIDE, use_clamp: true) @ "t" hide
  vector_math_10 = vector_math * math_7 @ hide
  vector_math_9 = edge1_p1 + vector_math_10 @ hide
  math_8 = vector_math_4 * vector_math_8 @ hide
  math_10 = vector_math_5 * vector_math_7 @ hide
  math_9 = math_8 - math_10 @ hide
  math_11 = Math(math_9, math_2, operation: DIVIDE, use_clamp: true) @ "s" hide
  vector_math_12 = vector_math_2 * math_11 @ hide
  vector_math_11 = edge2_q1 + vector_math_12 @ hide
  compare = vector_math_9 == vector_math_11 @ hide
  return ("Is Hit": compare, P: vector_math_9, Q: vector_math_11)
}

geometry graph ".Bevel Edge Width Clamped v1"(
    Geometry: Geometry,
    "Off/Min/Min per Island": Int,
    Selection: Bool,
    Width: Float(subtype: DISTANCE) = 0.1 in 0.0..10000.0
) -> (Geometry: Geometry, Selection: Bool, Width: Float) {
  "bisector and perpendicular " {
    position = Position() @ hide
    vector_math = FieldAtIndex(position, OffsetCornerInFace(offset: 1), domain: CORNER, data_type: FLOAT_VECTOR) - position @ hide
    vector_math_2 = FieldAtIndex(position, OffsetCornerInFace(offset: -1), domain: CORNER, data_type: FLOAT_VECTOR) - position @ hide
    vector_math_3 = normalize(vector_math) @ hide
    vector_math_4 = normalize(vector_math_2) @ hide
    vector_math_5 = vector_math_3 + vector_math_4 @ hide
    vector_math_6 = normalize(vector_math_5) @ hide
    normal = Normal() @ hide
    vector_math_11 = normal.true_normal × vector_math_3 @ hide
    vector_math_14 = normalize(vector_math_11) @ hide
    normal_2 = Normal() @ hide
    vector_math_21 = vector_math_4 × normal_2.true_normal @ hide
    vector_math_22 = normalize(vector_math_21) @ hide
  }
  {
    offset_corner_in_face = OffsetCornerInFace(offset: 1)
    position_2 = Position() @ hide
    field_at_index_2 = FieldAtIndex(
      position_2,
      offset_corner_in_face,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    position_3 = Position() @ hide
    position_4 = Position() @ hide
    position_8 = Position() @ hide
    vector_math_23 = field_at_index_2 - position_8 @ hide
  }
  {
    corners_of_edge = CornersOfEdge()
    corners_of_edge_2 = CornersOfEdge(sort_index: 1)
    offset_corner_in_face_3 = OffsetCornerInFace(corners_of_edge.corner_index, 1)
    offset_corner_in_face_4 = OffsetCornerInFace(corners_of_edge_2.corner_index, 1)
  }
  {
    edges_of_corner = EdgesOfCorner()
  }
  {
    offset_corner_in_face_2 = OffsetCornerInFace(offset: -1)
    position_5 = Position() @ hide
    field_at_index_6 = FieldAtIndex(
      position_5,
      offset_corner_in_face_2,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    position_6 = Position() @ hide
    position_7 = Position() @ hide
    position_9 = Position() @ hide
    vector_math_25 = field_at_index_6 - position_9 @ hide
  }
  {
    position_10 = Position() @ hide
    field_at_index_15 = FieldAtIndex(
      position_10,
      corners_of_edge.corner_index,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_27 = position_10 - field_at_index_15 @ hide
    position_11 = Position() @ hide
    field_at_index_17 = FieldAtIndex(
      position_11,
      corners_of_edge_2.corner_index,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_29 = position_11 - field_at_index_17 @ hide
    position_12 = Position() @ hide
    field_at_index_19 = FieldAtIndex(
      position_12,
      offset_corner_in_face_4,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_31 = position_12 - field_at_index_19 @ hide
    position_13 = Position() @ hide
    field_at_index_21 = FieldAtIndex(
      position_13,
      offset_corner_in_face_3,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_33 = position_13 - field_at_index_21 @ hide
  }
  capture_attribute_2 = CaptureAttribute(Geometry, Selection, domain: EDGE)
  capture_attribute = CaptureAttribute(
    capture_attribute_2.geometry,
    bisector: vector_math_6,
    perpendicular_next: vector_math_14,
    perpendicular_prev: vector_math_22,
    domain: CORNER)
  {
    field_at_index = FieldAtIndex(
      capture_attribute.bisector,
      offset_corner_in_face,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_8 = field_at_index * 999.0 @ hide
    vector_math_7 = field_at_index_2 + vector_math_8 @ hide
    vector_math_10 = capture_attribute.bisector * 999.0 @ hide
    vector_math_9 = position_4 + vector_math_10 @ hide
    vector_math_13 = closest_edge_edge_pair(position_4, vector_math_9, field_at_index_2, vector_math_7).p - position_3 @ hide
    vector_math_12 = capture_attribute.perpendicular_next ⋅ vector_math_13 @ hide
    vector_math_24 = vector_math_23 ⋅ capture_attribute.perpendicular_prev @ hide
  }
  {
    field_at_index_3 = FieldAtIndex(
      capture_attribute_2.selection,
      edges_of_corner.next_edge_index,
      domain: EDGE,
      data_type: BOOLEAN)
    field_at_index_4 = FieldAtIndex(
      capture_attribute_2.selection,
      edges_of_corner.previous_edge_index,
      domain: EDGE,
      data_type: BOOLEAN)
    boolean_math = field_at_index_3 and field_at_index_4 @ hide
    boolean_math_2 = field_at_index_3 or field_at_index_4 @ hide
  }
  {
    field_at_index_5 = FieldAtIndex(
      capture_attribute.bisector,
      offset_corner_in_face_2,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_16 = field_at_index_5 * 999.0 @ hide
    vector_math_15 = field_at_index_6 + vector_math_16 @ hide
    vector_math_18 = capture_attribute.bisector * 999.0 @ hide
    vector_math_17 = position_7 + vector_math_18 @ hide
    vector_math_20 = closest_edge_edge_pair(position_7, vector_math_17, field_at_index_6, vector_math_15).p - position_6 @ hide
    vector_math_19 = capture_attribute.perpendicular_prev ⋅ vector_math_20 @ hide
    vector_math_26 = capture_attribute.perpendicular_next ⋅ vector_math_25 @ hide
  }
  {
    field_at_index_7 = FieldAtIndex(
      field_at_index_3,
      offset_corner_in_face,
      domain: CORNER,
      data_type: BOOLEAN) @ hide
    field_at_index_8 = FieldAtIndex(
      field_at_index_4,
      offset_corner_in_face_2,
      domain: CORNER,
      data_type: BOOLEAN) @ hide
  }
  {
    field_at_index_9 = FieldAtIndex(vector_math_24, offset_corner_in_face, domain: CORNER) @ hide
    field_at_index_10 = FieldAtIndex(vector_math_26, offset_corner_in_face_2, domain: CORNER) @ hide
    math_4 = min(field_at_index_9, vector_math_26) @ hide
    math_5 = min(vector_math_24, field_at_index_10) @ hide
  }
  {
    switch = Switch(field_at_index_7, math_4, vector_math_12) @ hide
    switch_2 = Switch(field_at_index_8, math_5, vector_math_19) @ hide
    math_3 = min(switch, switch_2) @ hide
    switch_4 = Switch(field_at_index_3, math_5, math_4) @ hide
    switch_3 = Switch(boolean_math, Switch(boolean_math_2, 999.0, switch_4), math_3) @ hide
  }
  {
    field_at_index_11 = FieldAtIndex(
      capture_attribute_2.selection,
      EdgesOfCorner(corners_of_edge.corner_index).previous_edge_index,
      domain: EDGE,
      data_type: BOOLEAN)
    field_at_index_12 = FieldAtIndex(
      capture_attribute_2.selection,
      EdgesOfCorner(offset_corner_in_face_3).next_edge_index,
      domain: EDGE,
      data_type: BOOLEAN)
    field_at_index_13 = FieldAtIndex(
      capture_attribute_2.selection,
      EdgesOfCorner(corners_of_edge_2.corner_index).previous_edge_index,
      domain: EDGE,
      data_type: BOOLEAN)
    boolean_math_3 = field_at_index_13 or field_at_index_12 @ hide
    field_at_index_14 = FieldAtIndex(
      capture_attribute_2.selection,
      EdgesOfCorner(offset_corner_in_face_4).next_edge_index,
      domain: EDGE,
      data_type: BOOLEAN)
    boolean_math_5 = field_at_index_11 or field_at_index_14 @ hide
    boolean_math_6 = boolean_math_5 and boolean_math_3 @ hide
    boolean_math_4 = nimply(boolean_math_6, capture_attribute_2.selection) @ hide
  }
  {
    field_at_index_16 = FieldAtIndex(
      capture_attribute.perpendicular_prev,
      corners_of_edge.corner_index,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_28 = vector_math_27 ⋅ field_at_index_16 @ hide
    field_at_index_18 = FieldAtIndex(
      capture_attribute.perpendicular_prev,
      corners_of_edge_2.corner_index,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_30 = vector_math_29 ⋅ field_at_index_18 @ hide
    field_at_index_20 = FieldAtIndex(
      capture_attribute.perpendicular_next,
      offset_corner_in_face_4,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_32 = vector_math_31 ⋅ field_at_index_20 @ hide
    field_at_index_22 = FieldAtIndex(
      capture_attribute.perpendicular_next,
      offset_corner_in_face_3,
      domain: CORNER,
      data_type: FLOAT_VECTOR) @ hide
    vector_math_34 = vector_math_33 ⋅ field_at_index_22 @ hide
    math_7 = min(
      Switch(field_at_index_11, 999.0, vector_math_28),
      Switch(field_at_index_14, 999.0, vector_math_32)) @ hide
    math_8 = min(
      Switch(field_at_index_13, 999.0, vector_math_30),
      Switch(field_at_index_12, 999.0, vector_math_34)) @ hide
    math_9 = min(math_7, math_8) @ hide
  }
  capture_attribute_3 = CaptureAttribute(
    capture_attribute.geometry,
    Distance: switch_3,
    domain: CORNER)
  {
    math_2 = min(
      FieldAtIndex(capture_attribute_3.distance, corners_of_edge.corner_index, domain: CORNER),
      FieldAtIndex(capture_attribute_3.distance, corners_of_edge_2.corner_index, domain: CORNER)) @ hide
  }
  "edge min width " {
    math_6 = min(math_2, math_9) @ hide
    switch_5 = Switch(boolean_math_4, math_2, math_6) @ hide
    field_on_domain = FieldOnDomain(switch_5, domain: EDGE)
    math = min(Width, FieldMinAndMax(field_on_domain, domain: EDGE).min) @ hide
    math_10 = min(
      Width,
      FieldMinAndMax(field_on_domain, MeshIsland().island_index, domain: EDGE).min) @ hide
  }
  return (
    Geometry: IndexSwitch(off_min_min_per_island, Geometry, capture_attribute_3.geometry, capture_attribute_3.geometry),
    Selection: IndexSwitch(off_min_min_per_island, Selection, capture_attribute_2.selection, capture_attribute_2.selection),
    Width: IndexSwitch(off_min_min_per_island, Width, math, math_10))
}

geometry graph "Bevel Mesh Basic"(
    Mesh: Geometry,
    "Selection" {
        "Affect Kind": Menu(menu_expanded: true, optional_label: true) = Edges,
        Selection: Bool(description: "Selects elements of 'Affect Kind' for beveling", hide_value: true) = true,
        "Angle Threshold": Float(subtype: ANGLE) in 0.0..
    },
    "Profile"(default_closed: true) {
        Width: Float(subtype: DISTANCE, description: "Offset per vertex for vertex bevel (all edges)") = 0.1 in 0.0..,
        Factor: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
        Clamp: Menu = Off,
        Miter: Bool(description: "Use a miter for corner"),
        Spread: Float(subtype: DISTANCE, description: "Per corner specification of 'spread' for arc miters") = 0.1 in 0.0..,
        Segments: Int(description: "How many pieces is an edge beveled into, or, for vertex bevels, how many segments on the arcs between the edges.") = 1 in 1..,
        Shape: Float(subtype: FACTOR, description: "Superellipse shape parameter, used when there is no Profile, and also used for Arc and Patch miters") = 0.5 in 0.0..1.0,
        Profile: Geometry(description: "If present, the first curve will be sampled to give a custom profile on edges. The curve should be in the XY plane, going from (0,1,0) to (1,0,0)")
    },
    "Shading"(default_closed: true) {
        "Harden Normals": Bool(description: "Harden normals of new faces to adjacent faces."),
        "Material Index": Int = -1
    }
) -> (
    Mesh: Geometry,
    "Outputs"(default_closed: true) {
        "Vertex Face": Bool(description: "Identifies output faces that are in the new mesh parts for vertices"),
        "Edge Face": Bool(description: "Identifies output faces that are in the new mesh parts for edges"),
        "Outer Edge": Bool(description: "Identifies output edges that are on the outsides of new mesh parts for edges"),
        "Mid Edge": Bool(description: "Identifies output edges that are in the middle of new mesh parts of edges and continued through vertices (round down if odd number of segments)")
    }
) {
  "angle threshold" {
    compare = MeshEdgeAngle().unsigned_angle >= angle_threshold @ hide
    boolean_math = compare and Selection @ hide
  }
  "harden normal by adjacent faces" {
    index = Index() @ hide
    field_on_domain_2 = FieldOnDomain(index, data_type: INT)
  }
  "clamp mode" {
    menu_switch = MenuSwitch(Clamp, Off: 0, Minimum: 1, "Minimum per Island": 2)
  }
  "vertex midpoint (selection accounted) (4 limit)" {
    "other vertices" {
      mesh_edge_vertices = MeshEdgeVertices()
      position = Position() @ hide
      index_2 = Index() @ hide
      closure_output = closure("Sort Index": Int) -> (Value: Float) {
        edges_of_vertex = EdgesOfVertex(sort_index: sort_index)
        field_at_index = FieldAtIndex(
          mesh_edge_vertices.vertex_index_1,
          edges_of_vertex.edge_index,
          domain: EDGE,
          data_type: INT)
        compare_2 = index_2 == field_at_index @ hide
        switch_2 = Switch(
          compare_2,
          field_at_index,
          FieldAtIndex(mesh_edge_vertices.vertex_index_2, edges_of_vertex.edge_index, domain: EDGE, data_type: INT),
          input_type: INT) @ hide
        vector_math_4 = distance(
          FieldAtIndex(position, switch_2, data_type: FLOAT_VECTOR),
          position) @ hide
        return vector_math_4 / Switch(FieldAtIndex(Selection, switch_2, data_type: BOOLEAN), 1.0, 2.0)
      }
    }
    math = min(closure_output(), closure_output("Sort Index": 1)) @ hide
    math_2 = min(closure_output("Sort Index": 2), closure_output("Sort Index": 3)) @ hide
    math_3 = min(math, math_2) @ hide
  }
  "vertices or edges mode" {
    menu_switch_2 = MenuSwitch(affect_kind, Vertices: 0, Edges: 1)
  }
  "width" {
    math_6 = Width * Factor @ hide
  }
  "edge clamp" {
    group = bevel_edge_width_clamped_v1(Mesh, menu_switch.output, boolean_math, math_6)
  }
  "edges" {
    mesh_bevel = MeshBevel(
      group.geometry,
      group.selection,
      start_left_offset: group.width,
      start_right_offset: group.width,
      end_left_offset: group.width,
      end_right_offset: group.width,
      miter: Miter,
      spread: Spread,
      segments: Segments,
      shape: Shape,
      profile: Profile)
    combine_bundle = CombineBundle(
      Mesh: mesh_bevel.mesh,
      "Vertex Face": mesh_bevel.vertex_face,
      "Edge Face": mesh_bevel.edge_face,
      "Outer Edge": mesh_bevel.outer_edge,
      "Mid Edge": mesh_bevel.mid_edge)
  }
  "vertex clamp" {
    math_4 = min(math_6, FieldMinAndMax(math_3).min) @ hide
    math_5 = min(math_6, FieldMinAndMax(math_3, MeshIsland().island_index).min) @ hide
    index_switch = IndexSwitch(menu_switch.output, math_6, math_4, math_5)
  }
  "vertices" {
    mesh_bevel_2 = MeshBevel(
      Mesh,
      boolean_math,
      Vertices,
      end_right_offset: 1.0,
      offset: index_switch,
      miter: Miter,
      spread: Spread,
      segments: Segments,
      shape: Shape,
      profile: Profile)
    combine_bundle_2 = CombineBundle(
      Mesh: mesh_bevel_2.mesh,
      "Vertex Face": mesh_bevel_2.vertex_face,
      "Edge Face": mesh_bevel_2.edge_face,
      "Outer Edge": mesh_bevel_2.outer_edge,
      "Mid Edge": mesh_bevel_2.mid_edge)
  }
  index_switch_2 = IndexSwitch(menu_switch_2.output, combine_bundle_2, combine_bundle)
  "harden normal by adjacent faces" .. {
    separate_bundle = SeparateBundle(
      index_switch_2) -> (Mesh: Geometry, "Vertex Face": Bool, "Edge Face": Bool, "Outer Edge": Bool, "Mid Edge": Bool)
    {
      boolean_math_4 = separate_bundle.vertex_face or separate_bundle.edge_face @ hide
      field_on_domain = FieldOnDomain(boolean_math_4, domain: FACE, data_type: BOOLEAN)
      boolean_math_3 = not field_on_domain @ hide
      boolean_math_2 = boolean_math_3 and FieldOnDomain(field_on_domain, data_type: BOOLEAN) @ hide
      field_on_domain_3 = FieldOnDomain(boolean_math_2, domain: CORNER, data_type: BOOLEAN)
    }
    vector_math_2 = Normal().true_normal * field_on_domain_3 @ hide
    vector_math = AccumulateField(FieldOnDomain(vector_math_2, domain: CORNER, data_type: FLOAT_VECTOR), field_on_domain_2, data_type: FLOAT_VECTOR, domain: CORNER).total / AccumulateField(field_on_domain_3, field_on_domain_2, domain: CORNER).total @ hide
    vector_math_3 = normalize(vector_math) @ hide
    switch = Switch(
      harden_normals,
      separate_bundle.mesh,
      SetMeshNormal(separate_bundle.mesh, Switch(FieldOnDomain(separate_bundle.outer_edge, data_type: BOOLEAN), Normal().normal, vector_math_3, input_type: VECTOR), mode: TANGENT_SPACE),
      input_type: GEOMETRY) @ hide
  }
  "material index" {
    boolean_math_5 = boolean_math_4 and material_index != -1 @ hide
    set_material_index = SetMaterialIndex(switch, boolean_math_5, material_index)
  }
  separate_bundle_2 = SeparateBundle(
    index_switch_2) -> (Mesh: Geometry, "Vertex Face": Bool, "Edge Face": Bool, "Outer Edge": Bool, "Mid Edge": Bool)
  return (
    Mesh: set_material_index,
    "Vertex Face": separate_bundle_2.vertex_face,
    "Edge Face": separate_bundle_2.edge_face,
    "Outer Edge": separate_bundle_2.outer_edge,
    "Mid Edge": separate_bundle_2.mid_edge)
}
