// @profile "blender-geometry"

geometry graph "Curve Vectors"() -> (Vectors: Vector, "Is Valid": Bool) {
  position = Position() @ hide
  offset_point_in_curve = OffsetPointInCurve(offset: 1)
  index = Index() @ hide
  switch = Switch(
    offset_point_in_curve.is_valid_offset,
    index,
    offset_point_in_curve.point_index,
    input_type: INT) @ hide
  field_at_index = FieldAtIndex(position, switch, data_type: FLOAT_VECTOR) @ hide
  vector_math = field_at_index - position @ hide
  return (Vectors: vector_math, "Is Valid": offset_point_in_curve.is_valid_offset)
}
